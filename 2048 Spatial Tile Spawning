int insert_random(int board[][5], int numrows = 5)
{
    int r, c;
    int empty_count = 0;
    for (int r = 0; r < numrows; r++)
    {
        for (int c = 0; c < 5; c++)
        {
            if (board[r][c] == 0)
                empty_count++;
        }
    }

    if (empty_count > 0)
    {
        while (true)
        {
            r = rand() % numrows;
            c = rand() % 5; 
            if (board[r][c] == 0)
            {
                board[r][c] = 2 * (1 + (rand() % 2));
                break;
            }
        }
    }
    return 0;
}
//Scans the 5x5 grid to calculate the current number of available tiles (empty_count).
//Employs a random coordinate picker (rand() % numrows) to pinpoint open cells.
//Evaluates empty spaces and dynamically assigns values using the formula 2 * (1 + (rand() % 2)), establishing a 50/50 probability baseline for spawning either a 2 or a 4
